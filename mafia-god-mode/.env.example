# Production room storage (Vercel Marketplace > Upstash Redis injects these automatically).
# Without them the app falls back to in-memory rooms, which only work on a single local server.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Long random string that unlocks reading feedback at /#admin and GET /api/feedback. Reading is disabled when unset.
FEEDBACK_ADMIN_KEY=
